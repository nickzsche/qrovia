# Base URL used for short links shown in the UI and encoded into QR codes.
# Optional: falls back to the request Origin/Host header, then localhost:3430.
APP_URL=http://localhost:3430

# JWT signing secret for session cookies. REQUIRED in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-in-production-please-generate-a-real-secret

# Directory holding the SQLite database file. Optional; defaults to ./data.
# QROVIA_DATA_DIR=./data

# Set to 1 to allow non-Secure session cookies in production (e.g. behind a
# plain-HTTP reverse proxy). Leave unset to keep cookies Secure in production.
# FORCE_INSECURE_COOKIE=1
